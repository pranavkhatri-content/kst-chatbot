# Copy this file to .env

# ── LLM provider switch ──────────────────────────────────────────
# "gemini"   → Google Gemini API (paid, needs GEMINI_API_KEY)
# "internal" → Kelkoo internal Gemma server (free)
# Flip this one line to switch — no code changes needed.
LLM_PROVIDER=gemini

# Google Gemini (used when LLM_PROVIDER=gemini)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Internal Kelkoo LLM (used when LLM_PROVIDER=internal)
LLM_BASE_URL=http://dc1-kdp-dev-worker-01.dev.dc1.kelkoo.net:8100/v1
LLM_MODEL=gemma-4-E4B-it-BF16.gguf

# Local embedding model — always local, free, used by BOTH providers
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Max tokens the model may generate per answer (both providers).
# For the internal reasoning model this includes hidden thinking tokens.
MAX_OUTPUT_TOKENS=10000
